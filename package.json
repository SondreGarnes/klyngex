{
  "name": "klyngex",
  "productName": "Klyngex",
  "version": "0.2.2",
  "private": true,
  "description": "Parallel terminal workspace for coding agents.",
  "license": "MIT",
  "author": "Sondre Garnæs",
  "homepage": "https://github.com/SondreGarnes/klyngex",
  "repository": "github:SondreGarnes/klyngex",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test.js",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.klyngex.app",
    "productName": "Klyngex",
    "asar": false,
    "npmRebuild": false,
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "status.js",
      "hooks-install.js",
      "transcript.js",
      "worktree.js",
      "index.html",
      "claude-hooks.json",
      "terminal-agent-app-icons/app-icon.ico",
      "terminal-agent-app-icons/icon_512x512.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "terminal-agent-app-icons/app-icon.ico",
      "artifactName": "Klyngex-Setup.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "terminal-agent-app-icons/app-icon.icns",
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Klyngex-${arch}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "terminal-agent-app-icons/icon_512x512.png",
      "category": "Development",
      "artifactName": "Klyngex-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "SondreGarnes",
      "repo": "klyngex",
      "releaseType": "release"
    }
  }
}
